# Copy to backend/.env and fill in. Never commit the real .env.

# --- Core ---
# development | production  (production enforces SECRET_KEY and disables API docs)
ENVIRONMENT=development
PORT=8000

# --- Database ---
# Local example uses SQLite; production uses PostgreSQL (RDS).
DATABASE_URL=postgresql://user:password@localhost:5432/interview_sim

# --- Auth / JWT ---
# REQUIRED in production. Generate one: openssl rand -hex 32
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS ---
# Comma-separated allowlist of frontend origins. Do NOT use "*" in production.
CORS_ORIGINS=https://vdhaya-interview-simulator.com,http://localhost:5173

# --- AWS (Bedrock / Polly / Transcribe) ---
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=us-east-1
BEDROCK_MODEL_ID=
